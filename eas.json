{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "image": "sdk-52"
      },
      "distribution": "internal",
      "node": "20.18.0",
      "env": {
        "APP_VARIANT": "cliente",
        "EXPO_PUBLIC_ES_VENDEDOR": "0"
      }
    },
    "vendedor": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "vendedor",
        "EXPO_PUBLIC_ES_VENDEDOR": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-52"
      }
    }
  }
}
